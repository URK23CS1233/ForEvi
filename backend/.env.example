# Copy to .env and adjust. Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/forevi
SECRET_KEY=change-me-to-a-64-char-hex-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Seeded super admin (change the password after first login)
ADMIN_EMAIL=admin@forevi.in
ADMIN_PASSWORD=ChangeMe@123

# Optional Redis for multi replica realtime and rate limiting (empty = in memory)
REDIS_URL=

# Pluggable embedding backend: "stub" runs with no downloads.
# On the workstation, set this to a real provider once weights are available.
EMBEDDING_PROVIDER=stub

# Ingestion
MAX_UPLOAD_MB=200
CONSISTENCY_THRESHOLD=0.62

# Logging: json in production, set to false for readable dev logs
LOG_JSON=true
ENVIRONMENT=development
